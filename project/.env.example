# 이 파일을 .env 로 복사하거나 아래 값을 환경변수로 export 하세요.
# 아무 것도 설정하지 않아도 '오프라인 모드'로 데모가 동작합니다.

# --- MCP 서버 연결 (선택, 기본값 있음) ---
# 완전 분리 구조: 에이전트·API 는 별도 프로세스의 MCP 서버에 HTTP 로 연결합니다.
# run.sh·docker compose 가 자동으로 설정하므로 보통 손댈 일이 없습니다.
# MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# MCP_SERVER_HOST=              # Render fromService(host) 주입용 — 설정 시 URL 보다 우선
# MCP_SERVER_PORT=8001          # MCP_SERVER_HOST 와 조합할 고정 포트
# MCP_AUTH_TOKEN=               # MCP 서버 Bearer 토큰 — 공개 URL 배포 시 필수(서버·클라이언트 동일 값)
# MCP_REQUIRE_AUTH=1            # 공개 배포 가드 — 토큰 없이 기동하려 하면 preflight 가 거부

# --- 사용자 로그인 (선택 · 공개 배포 시 필수) ---
# Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: <공개주소>/auth/callback  (로컬: http://localhost:8000/auth/callback)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# SESSION_SECRET=               # 32자 이상 무작위 값: python -c 'import secrets;print(secrets.token_urlsafe(48))'
# SESSION_COOKIE_SECURE=0       # http://localhost 로 로그인 테스트할 때만 0 (배포는 기본값 1 유지)
# PUBLIC_BASE_URL=https://...   # 프록시 뒤 배포에서 콜백 주소 고정(예: Cloud Run 서비스 URL)
# ALLOWED_EMAILS=a@gmail.com,b@gmail.com   # 비우면 Google 계정 누구나
# ALLOWED_DOMAINS=example.com              # 도메인 단위 허용(사내 계정 등)
# DAILY_CHAT_LIMIT=30           # 사용자별 하루(KST) 질문 상한, 0 이하면 무제한
# REQUIRE_LOGIN=1               # 공개 배포 가드 — 로그인 설정 없이 기동하면 preflight 가 거부

# --- LLM 모드 (선택) ---
# Enterprise LLM API 키를 넣으면 에이전트가 실제 Claude tool-use 루프로 동작합니다.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8

# --- RAG 하이퍼파라미터 (선택, 기본값 있음) ---
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# RETRIEVE_TOP_K=8
# RERANK_TOP_N=3
# HYBRID_ALPHA=0.5       # 벡터(1.0) ~ 키워드(0.0) 사이 결합 가중
# RERANK_WEIGHT=0.9      # 리랭커 신호 vs 1차 하이브리드 점수 prior 결합(0~1)
# RERANK_IDF_POWER=0.5   # 리랭커 토큰 가중 idf^p (0=균등)
# RERANK_CONTRAST_PENALTY=0.3    # 대조 섹션("~와의 차이") 페널티
# RERANK_PREAMBLE_PENALTY=0.055  # 서두 섹션("목적/개요") 감쇠
# EMBEDDER_KIND=tfidf    # tfidf | hashing | voyage
# QUERY_EXPANSION=1      # 도메인 동의어 질의 확장(부작용→이상사례). 0이면 끔

# --- 벡터 스토어(선택) ---
# 기본 memory 는 부팅마다 코퍼스 전체를 다시 임베딩해 메모리에 둔다. pgvector 로 바꾸면
# Postgres(pgvector 확장)에 청크·임베딩을 영속화하고 유사도 검색을 DB 가 수행한다 —
# 재부팅 시 바뀐 청크만 증분 임베딩. 밀집 임베더(EMBEDDER_KIND=dense 또는 auto→dense)가 전제.
# 로컬 DB 포함 실행: docker compose -f docker-compose.yml -f docker-compose.pgvector.yml up --build
# VECTOR_STORE=pgvector
# PGVECTOR_URL=postgresql://rapv:rapv@127.0.0.1:5432/rapv
# PGVECTOR_POOL=0        # 벡터 후보 풀(0=전수 — 인메모리와 동일 결과, 양수=HNSW 상위 n 만)

# --- 상용 임베딩(선택) ---
# EMBEDDER_KIND=voyage 로 두고 아래 키를 넣으면 실제 밀집 임베딩으로 검색합니다.
# VOYAGE_API_KEY=pa-...
